[Unit]
Description=Cora Command Center — Slack Q&A worker (cc:events stream)
After=network-online.target postgresql.service redis-server.service cora.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Forced-action-
Environment="PATH=/root/Forced-action-/.venv/bin"
EnvironmentFile=/root/Forced-action-/.env

ExecStart=/root/Forced-action-/.venv/bin/python -m src.agents.cora.command_center.worker

Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cora-command-center

[Install]
WantedBy=multi-user.target
