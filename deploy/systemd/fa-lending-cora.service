[Unit]
Description=Forced Action - Next Deal Lending Cora sweep worker (draft expiry, card retry, approved sends)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/Forced-action-
Environment="PATH=/root/Forced-action-/.venv/bin"
Environment="PYTHONPATH=/root/Forced-action-"
EnvironmentFile=/root/Forced-action-/.env
# Slack messages and clicks reach Cora through lending-api (HTTP); this unit only runs the minute sweep.
# Needs LENDING_SLACK_BOT_TOKEN, LENDING_CORA_CHANNEL, LENDING_CORA_APPROVER_USER_IDS and ANTHROPIC_API_KEY;
# exits with status 1 if any is missing.
ExecStart=/root/Forced-action-/.venv/bin/python -m src.lending.cora_agent
Restart=always
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fa-lending-cora

[Install]
WantedBy=multi-user.target
