[Unit]
Description=Forced Action API (fa-api) — Gunicorn Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Forced-action-
Environment="PATH=/root/Forced-action-/.venv/bin"
EnvironmentFile=/root/Forced-action-/.env
ExecStart=/root/Forced-action-/.venv/bin/gunicorn src.api.main:app -k uvicorn.workers.UvicornWorker --workers 4 --bind 127.0.0.1:8000
ExecReload=/bin/kill -s HUP $MAINPID

# Auto-restart if the service crashes
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fa-api

[Install]
WantedBy=multi-user.target
