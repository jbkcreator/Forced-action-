[Unit]
Description=Forced Action — Lending booking confirmation / reminder worker (WP-GL-10)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/Forced-action-
Environment="PATH=/root/Forced-action-/.venv/bin"
Environment="PYTHONPATH=/root/Forced-action-"
EnvironmentFile=/root/Forced-action-/.env
ExecStart=/root/Forced-action-/.venv/bin/python -m src.lending.reminder_worker
Restart=always
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fa-lending-reminder-worker

[Install]
WantedBy=multi-user.target
