[Unit]
Description=Forced Action Relay Slack approval listener (Socket Mode)
After=network.target fa-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/Forced-action-
Environment="PATH=/root/Forced-action-/.venv/bin"
EnvironmentFile=/root/Forced-action-/.env
ExecStart=/root/Forced-action-/.venv/bin/python -m src.services.relay.socket_listener
Restart=always
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fa-relay-slack-listener

[Install]
WantedBy=multi-user.target
