# Lending routes go to the lending-api service (127.0.0.1:8010), not fa-api.
# Add inside the existing server block, ABOVE the generic "location /webhooks/" and "location /api/"
# blocks. The longer prefix wins, so only these two prefixes move; public URLs stay the same.
location /webhooks/lending/ {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
}

# Borrower document upload (P2.4). The token in the path is the borrower's key: no access log here. Body limit just
# above the app's 10 MB per file (config/lending_partners.MAX_UPLOAD_BYTES) plus the form; nginx's default is 1 MB.
location /api/lending/docs/ {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    client_max_body_size 11m;
    access_log off;
}

# LendingFlow lead webhook (R1 0.5 D13): same proxy, plus its raw body written to the edge log the 2 AM reconcile
# replays (src/lending/inbound/lendingflow_edge_log.py). Needs the http-level log_format in
# deploy/nginx/lendingflow-body-log.conf.example. The body buffer equals the app's limit (config/lending_lendingflow
# MAX_BODY_BYTES = 256 KB) so the body stays in memory and is logged. Headers (the webhook secret) are NOT logged.
location = /api/lending/lendingflow {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
    client_max_body_size 256k;
    client_body_buffer_size 256k;
    access_log /var/log/nginx/lendingflow_body.log lendingflow_body;
}

# Website lead form (POST /api/lending/web-leads).
location /api/lending/ {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
}
