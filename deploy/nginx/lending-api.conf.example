# Lending routes go to the lending-api service (127.0.0.1:8010), not fa-api.
# Add inside the existing server block, ABOVE the generic "location /webhooks/" and "location /api/"
# blocks. The longer prefix wins, so only these two prefixes move; public URLs stay the same.
location /webhooks/lending/ {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
}

# Borrower document upload (P2.4). The token in the path is the borrower's key: no access log here. Body limit just
# above the app's 10 MB per file (config/lending_partners.MAX_UPLOAD_BYTES) plus the form; nginx's default is 1 MB.
location /api/lending/docs/ {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    client_max_body_size 11m;
    access_log off;
}

# Website lead form (POST /api/lending/web-leads).
location /api/lending/ {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
}
