# R1 0.5 D13: copy to /etc/logrotate.d/lendingflow-body-log. Daily, 7 days, root-only (the bodies carry PII).
# The 2 AM reconcile reads the current file and lendingflow_body.log.1, so .1 must stay uncompressed (delaycompress).
/var/log/nginx/lendingflow_body.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
