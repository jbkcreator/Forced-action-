{
  "version": "1.0",
  "description": "Market timing multipliers for Sprint 4.7 Phase 3 CDS integration. Not active until Phase 3 wires market_timing_config.py into cds_engine.py. Pressure labels match market_pressure_service.py output.",
  "signals": {
