# R1 0.7: staging mirror of the production settings. Copy to the staging host as .env and fill in the staging values.
# Every name below is a real setting (config/settings.py). Nothing here is a secret: keys stay blank until set on the host.
#
# Principle: staging mirrors production's code, tables and lender rules, but cannot reach a real borrower, a real
# lender, or the production database. Anything that sends is off or pointed at a test account.

# ── Its own database and cache (never the production ones) ──
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:5432/distress_staging
REDIS_URL=redis://STAGING_HOST:6379/0

# ── Lender rules: read from the table, like production. Load production's rules with
#    scripts/rollback_lender_rules.py --export N (on production) and --import FILE --yes (on staging). ──
LENDING_RULES_FROM_DB=true

# ── Admin token for /api/lending/loan-files/*/stage and /api/lending/lender-rules/* (a different value than prod) ──
LENDING_ADMIN_TOKEN=

# ── Cora: a separate Slack app and test channels, so staging never posts to Josh's real channels ──
LENDING_CORA_SLACK_BOT_TOKEN=
LENDING_CORA_SLACK_APP_TOKEN=
LENDING_CORA_CHANNEL=
LENDING_CORA_APPROVALS_CHANNEL=
LENDING_DEALS_CHANNEL=
LENDING_CORA_APPROVER_USER_IDS=

# ── Sends: off. Turn one on only against a test GHL sub-account and test numbers. ──
LENDING_GHL_API_KEY=
LENDING_GHL_LOCATION_ID=
LENDING_SMS_CARRIER_APPROVED=false
MISSED_CALL_TEXT_ENABLED=false
LENDING_INTRO_SMS_ENABLED=false
LENDING_INSTANTLY_API_KEY=
LENDING_INSTANTLY_CAMPAIGN_ID=
BATCHDIALER_API_KEY=
